# FanFunnel environment — copy this file to `.env.local` and fill in the values.
#
# With NONE of these set, the app runs in zero-config demo mode against an
# in-memory store. Set all three to run against a real Supabase project so fan
# links, spins, and redemptions persist. Get the values from your Supabase
# project: Settings → API.
#
# Names only: never commit a value. On Vercel, set these per scope
# (Production = LIVE, Preview = TEST); the full table, with scopes and
# warnings, is DEPLOY.md section 3.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY, bypasses Row Level Security. Never expose
# this to the browser or commit it. Used to record spins atomically.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to claim admin via /admin (one-time bootstrap).
ADMIN_EMAILS=

# 1 = never fall back to the in-memory demo when Supabase isn't configured
# (Vercel Production already forces this).
FF_REQUIRE_SUPABASE=

# 1 = Preview only: the ?debug=1 console and the environment badge. Never on Production.
NEXT_PUBLIC_ENABLE_DEBUG=

# Optional: public origin for links in alert e-mails, when not on Vercel.
NEXT_PUBLIC_SITE_URL=

# --- Scheduled retention (server only) ------------------------------------------
# Authorizes the daily cron (/api/cron/retention). At least 16 characters.
# Generate: openssl rand -hex 32. Unset = the cron refuses to run and alerts.
CRON_SECRET=

# --- Instant-delivery prizes (server only, Sensitive) -----------------------------
# Base64 of exactly 32 random bytes. Generate: openssl rand -base64 32.
# NEVER rotate or replace without re-encrypting stored rewards; back it up.
REWARD_ENCRYPTION_KEY=
# Optional integer key version for new ciphertexts (default 1).
REWARD_ENCRYPTION_KEY_VERSION=
# Only during a planned key rotation (docs/GO_LIVE.md section 4): the key that was
# current before, so stored rewards sealed with it still open, and its version when
# it is not exactly one below REWARD_ENCRYPTION_KEY_VERSION. Unset otherwise.
REWARD_ENCRYPTION_KEY_PREVIOUS=
REWARD_ENCRYPTION_KEY_PREVIOUS_VERSION=
# Separate base64 32-byte key for code uniqueness. Generate: openssl rand -base64 32.
# NEVER rotate it: erased codes could be handed out again.
REWARD_CODE_FINGERPRINT_KEY=

# --- Web push (VAPID) ------------------------------------------------------------
# Generate the pair: npx web-push generate-vapid-keys. The private key is server only.
VAPID_PUBLIC_KEY=
# Alias of VAPID_PUBLIC_KEY (the public half only; set one of the two).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# --- Error and safety-report alert e-mails (server only) ------------------------
# A Resend API key restricted to sending, and comma-separated recipients.
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Optional: sender (default "FanFunnel <alerts@easysimplesites.org>") and which environments e-mail
# (comma list of production, preview, development; default production).
ALERT_EMAIL_FROM=
ALERT_ENVIRONMENTS=
# Optional: sender of creator account mail (approval, invitations); default
# "FanFunnel <account@domain of the alert sender>". Must be a verified Resend address.
ACCOUNT_EMAIL_FROM=

# --- Shared rate limits (optional) ----------------------------------------------
# Set by Vercel's Upstash integration (KV_REST_API_*), or use Upstash's own names.
# Unset = per-instance in-memory limits.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ops (batch 6). Heartbeat monitor ping URL, https only; pinged after each successful daily maintenance run. Never logged.
HEARTBEAT_URL=
# Maintenance mode: 1 pauses the public site (see docs/RUNBOOK.md). Redeploy after changing it.
FF_MAINTENANCE=
# Short commit shown on the Preview badge for CLI archive deploys (Vercel Git deploys set VERCEL_GIT_COMMIT_SHA).
NEXT_PUBLIC_COMMIT_SHA=
